# Copier ce fichier en .env sur le serveur, puis remplir les valeurs.
# Ce fichier .env contient des secrets : ne jamais le publier ni l'envoyer par e-mail.

DJANGO_DEBUG=0
# Chaîne aléatoire d'au moins 50 caractères : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Domaine du site (le premier sert d'adresse principale). Avant la réservation du domaine,
# l'adresse fournie par Opalstack (ex. yeba.UTILISATEUR.opalstacked.com) convient.
DJANGO_ALLOWED_HOSTS=yeba.cd,www.yeba.cd
DJANGO_SITE_URL=https://yeba.cd

# Dossier des images et documents envoyés dans l'administration (application statique yeba_media)
DJANGO_MEDIA_ROOT=

# Base de données : sqlite (par défaut, suffit largement pour ce site) ou postgresql
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=yeba
# DJANGO_DB_USER=yeba
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# E-mail (boîte créée chez Opalstack) : messages du formulaire de contact, alertes, mot de passe oublié
DJANGO_EMAIL_HOST=smtp.us.opalstack.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_FROM=Yeba <contact@yeba.cd>
# Qui reçoit les messages de contact et les alertes d'erreur (séparer par des virgules)
DJANGO_ADMINS=contact@yeba.cd

# Sécurité HTTPS : HSTS une heure au départ, puis 31536000 (un an) quand tout fonctionne
DJANGO_HSTS_SECONDS=3600
# 1 si la redirection HTTP vers HTTPS n'est pas faite par le site Opalstack
DJANGO_SSL_REDIRECT=0
# Compression gzip par Django : 0 si Opalstack compresse déjà
DJANGO_GZIP=1
